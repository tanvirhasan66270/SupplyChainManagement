<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_bg"
    tools:context=".Profile_View_Activity">

    <!-- Custom Toolbar -->
    <View
        android:id="@+id/toolbarBg"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintTop_toTopOf="@id/toolbarBg"
        app:layout_constraintBottom_toBottomOf="@id/toolbarBg"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="Back" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Profile"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/scm_blue"
        app:layout_constraintTop_toTopOf="@id/toolbarBg"
        app:layout_constraintBottom_toBottomOf="@id/toolbarBg"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        android:layout_marginStart="8dp" />

    <LinearLayout
        android:id="@+id/btnEditTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="@id/toolbarBg"
        app:layout_constraintBottom_toBottomOf="@id/toolbarBg"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_edit_outline"
            app:tint="@color/blue_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:textColor="@color/blue_primary"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarBg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded_white"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/imageContainer"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_person"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_view"
                        android:background="@drawable/bg_card_rounded_white"
                        android:padding="6dp"
                        android:layout_gravity="bottom|end"
                        app:tint="@color/blue_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Rashed Khan"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/scm_blue"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/imageContainer"
                    app:layout_constraintStart_toEndOf="@id/imageContainer"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/profileRoleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Role: "
                    android:textSize="14sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/profileName"
                    app:layout_constraintStart_toEndOf="@id/imageContainer" />

                <TextView
                    android:id="@+id/profileRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CUSTOMER"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_primary"
                    app:layout_constraintTop_toTopOf="@id/profileRoleLabel"
                    app:layout_constraintStart_toEndOf="@id/profileRoleLabel" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toBottomOf="@id/profileRole"
                    app:layout_constraintStart_toEndOf="@id/imageContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/profileScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.9"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_main" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_star"
                                app:tint="#FFC107" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" SCORE"
                                android:textSize="10sp"
                                android:textColor="@color/gray_text" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/gray_light"
                        android:layout_marginVertical="4dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/profileStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/green_status" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/green_status" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" STATUS"
                                android:textSize="10sp"
                                android:textColor="@color/gray_text" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Avatar Actions -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChooseImage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Choose New Image"
                android:textAllCaps="false"
                android:textColor="@color/gray_text"
                android:background="@drawable/bg_card_rounded_white"
                android:drawableStart="@drawable/ic_image"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawablePadding="8dp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnUploadAvatar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="UPLOAD NEW AVATAR"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/btn_login_gradient"
                android:drawableStart="@drawable/ic_cloud_upload"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawablePadding="8dp"
                android:visibility="gone" />

            <!-- Completion Profile -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_rounded_white"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvCompletionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completion Profile"
                    android:textSize="14sp"
                    android:textColor="@color/scm_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvCompletionPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_primary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ProgressBar
                    android:id="@+id/profileProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="100"
                    android:progressDrawable="@drawable/bg_tracking_gradient"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvCompletionLabel" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/profileProgressBar">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:id="@+id/checkName"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/green_status" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Customer Name Node"
                            android:textSize="13sp"
                            android:textColor="@color/text_main"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:id="@+id/checkComm"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/green_status" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Communication Link"
                            android:textSize="13sp"
                            android:textColor="@color/text_main"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/checkAvatar"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/green_status" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Identity Avatar Image"
                            android:textSize="13sp"
                            android:textColor="@color/text_main"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- EDIT PERSONAL SETTINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDIT PERSONAL SETTINGS"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/scm_blue"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded_white"
                android:padding="8dp">

                <!-- Full Name -->
                <include
                    android:id="@+id/rowName"
                    layout="@layout/layout_profile_row" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_light" android:layout_marginHorizontal="16dp" />

                <!-- Email -->
                <include
                    android:id="@+id/rowEmail"
                    layout="@layout/layout_profile_row" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_light" android:layout_marginHorizontal="16dp" />

                <!-- Mobile -->
                <include
                    android:id="@+id/rowPhone"
                    layout="@layout/layout_profile_row" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_light" android:layout_marginHorizontal="16dp" />

                <!-- Gender -->
                <include
                    android:id="@+id/rowGender"
                    layout="@layout/layout_profile_row" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_light" android:layout_marginHorizontal="16dp" />

                <!-- DOB -->
                <include
                    android:id="@+id/rowDob"
                    layout="@layout/layout_profile_row" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_light" android:layout_marginHorizontal="16dp" />

                <!-- NID -->
                <include
                    android:id="@+id/rowNid"
                    layout="@layout/layout_profile_row" />
            </LinearLayout>

            <!-- LOGISTICS & LOCATION METADATA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOGISTICS \u0026 LOCATION METADATA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/scm_blue"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded_white"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/blue_soft"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/blue_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYSTEM TRACK TERMINAL"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/blue_primary"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTerminalDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Division Node: Dhaka\nDistrict Sector: Dhaka\nPolice Station: Uttara"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_main" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detailed Dispatch Address HQ"
                    android:textSize="13sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvDetailedAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="House 12, Road 4, Dhanmondi, Dhaka"
                    android:background="@color/gray_bg_light"
                    android:padding="12dp"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_main" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_rounded_white"
                android:padding="8dp"
                android:layout_marginTop="16dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_hourglass"
                    app:tint="@color/gray_text" />
                <TextView
                    android:id="@+id/tvRegisteredTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registered: Jun 30, 2026, 10:52:25 PM"
                    android:textSize="11sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:text="UPDATE PROFILE REGISTRY"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/btn_login_gradient"
                android:drawableStart="@drawable/ic_check_circle"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:drawablePadding="12dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>