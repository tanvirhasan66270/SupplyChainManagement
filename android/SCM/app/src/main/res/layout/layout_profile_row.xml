<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <View
        android:id="@+id/iconBg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_card_rounded_white"
        android:backgroundTint="@color/blue_soft"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_person"
        app:tint="@color/blue_primary"
        app:layout_constraintTop_toTopOf="@id/iconBg"
        app:layout_constraintBottom_toBottomOf="@id/iconBg"
        app:layout_constraintStart_toStartOf="@id/iconBg"
        app:layout_constraintEnd_toEndOf="@id/iconBg" />

    <TextView
        android:id="@+id/rowLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Label"
        android:textSize="12sp"
        android:textColor="@color/gray_text"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rowValue"
        app:layout_constraintStart_toEndOf="@id/iconBg"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/rowValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Value"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_main"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/rowLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iconBg"
        app:layout_constraintEnd_toStartOf="@id/rowAction" />

    <ImageView
        android:id="@+id/rowAction"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/gray_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>