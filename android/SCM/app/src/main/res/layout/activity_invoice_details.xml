<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".Invoice_Details_Activity">

    <!-- Top Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/white"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="140dp"
            android:layout_height="45dp"
            android:layout_marginStart="16dp"
            android:scaleType="fitStart"
            android:src="@mipmap/logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvHeaderInvoiceNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invoice #TRN-..."
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_rounded_white"
                android:backgroundTint="#F8FBFF"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_invoice"
                    app:tint="#1A1A1A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="INVOICE DETAILS"
                    android:textColor="#1A1A1A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomActions"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Section 1: INVOICE DETAILS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_blue"
                            android:backgroundTint="#F5F5F5"
                            android:padding="4dp"
                            android:src="@drawable/ic_invoice"
                            app:tint="#1A1A1A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="INVOICE DETAILS"
                            android:textColor="#1A1A1A"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <include
                        android:id="@+id/rowInvoiceNum"
                        layout="@layout/layout_invoice_field_row" />

                    <include
                        android:id="@+id/rowRecordId"
                        layout="@layout/layout_invoice_field_row" />

                    <include
                        android:id="@+id/rowOrderId"
                        layout="@layout/layout_invoice_field_row" />

                    <include
                        android:id="@+id/rowIssuedTo"
                        layout="@layout/layout_invoice_field_row" />

                    <include
                        android:id="@+id/rowEmail"
                        layout="@layout/layout_invoice_field_row" />

                    <include
                        android:id="@+id/rowSalesOfficer"
                        layout="@layout/layout_invoice_field_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: FINANCIAL BREAKDOWN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_blue"
                            android:backgroundTint="#F5F5F5"
                            android:padding="4dp"
                            android:src="@drawable/ic_wallet"
                            app:tint="#1A1A1A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="FINANCIAL BREAKDOWN"
                            android:textColor="#1A1A1A"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Table Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F9F9F9"
                        android:orientation="horizontal"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Label"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Amount"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <include android:id="@+id/tableRowCurrency" layout="@layout/layout_invoice_table_row" />
                    <include android:id="@+id/tableRowSubtotal" layout="@layout/layout_invoice_table_row" />
                    <include android:id="@+id/tableRowTax" layout="@layout/layout_invoice_table_row" />
                    <include android:id="@+id/tableRowDiscount" layout="@layout/layout_invoice_table_row" />
                    <include android:id="@+id/tableRowShipping" layout="@layout/layout_invoice_table_row" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                    <include android:id="@+id/tableRowTotal" layout="@layout/layout_invoice_table_row" />
                    <include android:id="@+id/tableRowPaid" layout="@layout/layout_invoice_table_row" />
                    <include android:id="@+id/tableRowDue" layout="@layout/layout_invoice_table_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: PAYMENT & STATUS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_blue"
                            android:backgroundTint="#F5F5F5"
                            android:padding="4dp"
                            android:src="@drawable/ic_bank"
                            app:tint="#1A1A1A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="PAYMENT \u0026 STATUS"
                            android:textColor="#1A1A1A"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <include android:id="@+id/rowPaymentStatus" layout="@layout/layout_invoice_field_row" />
                    <include android:id="@+id/rowPaymentMethod" layout="@layout/layout_invoice_field_row" />
                    <include android:id="@+id/rowTransactionRef" layout="@layout/layout_invoice_field_row" />
                    <include android:id="@+id/rowInvoiceStatus" layout="@layout/layout_invoice_field_row" />
                    <include android:id="@+id/rowIssuedDate" layout="@layout/layout_invoice_field_row" />
                    <include android:id="@+id/rowDeliveryDate" layout="@layout/layout_invoice_field_row" />
                    <include android:id="@+id/rowDeliveryAddress" layout="@layout/layout_invoice_field_row" />
                    <include android:id="@+id/rowNotes" layout="@layout/layout_invoice_field_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="CLOSE"
            android:textColor="#1A1A1A"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_close"
            app:iconTint="#1A1A1A"
            app:strokeColor="#DDDDDD" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadPdf"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#1A1A1A"
            android:text="DOWNLOAD PDF"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_download"
            app:iconTint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
